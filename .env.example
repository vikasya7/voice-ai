# Required to start the backend
DATABASE_URL=postgresql://username:password@localhost:5432/voice_agent
OPENAI_API_KEY=
SARVAM_API_KEY=

# Twilio voice calls. Use the public hostname without https:// or a path.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
NGROK_DOMAIN=

# Optional web search
PARALLEL_API_KEY=

# Live /call and /voice routes. Leave empty to disable.
# Send this secret in the X-Live-API-Key header.
LIVE_API_KEY=

# Optional outbound calling. Leave empty to disable.
# Generate a value locally with: openssl rand -hex 32
OUTBOUND_CALL_API_KEY=

# Optional staff callback email address
HANDOFF_NOTIFICATION_EMAIL=

# Optional staff callback queue. Leave empty to disable its API.
# Generate a separate value locally with: openssl rand -hex 32
STAFF_HANDOFF_API_KEY=
